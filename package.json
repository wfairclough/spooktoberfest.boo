{
  "name": "spooktoberfest",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @spooktoberfest/web build",
    "check": "pnpm --filter @spooktoberfest/web check",
    "dev": "pnpm --filter @spooktoberfest/web dev",
    "format": "pnpm --filter @spooktoberfest/web format",
    "lint": "pnpm --filter @spooktoberfest/web lint",
    "test": "pnpm --filter @spooktoberfest/web test:unit -- --run",
    "test:e2e": "pnpm --filter @spooktoberfest/web test:e2e"
  }
}
